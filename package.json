{
  "name": "mxs",
  "version": "1.2.0",
  "description": "⚔️ The typed helpers every Node and React project rewrites: typed URLs, retry, debounce, storage and React hooks. Zero dependencies, ESM.",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "default": "./dist/react.js"
    }
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write . \"!eslint-fixtures/**\"",
    "build": "vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "bump:patch": "npm version patch --no-git-tag-version",
    "bump:minor": "npm version minor --no-git-tag-version",
    "bump:major": "npm version major --no-git-tag-version",
    "validate": "npm run lint && npm test",
    "typecheck": "tsc --noEmit",
    "check:changelog": "tsx scripts/check-changelog/run.ts",
    "check:release": "tsx scripts/check-release/run.ts",
    "release-notes": "tsx scripts/release-notes/run.ts"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "vitest related --run"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/helderberto/maximus.git"
  },
  "author": "Helder Burato Berto <helder.burato@gmail.com> (https://helderburato.com)",
  "keywords": [
    "maximus",
    "mxs",
    "typescript",
    "path",
    "url",
    "build-path",
    "match-path",
    "esm",
    "node",
    "react"
  ],
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@commitlint/cli": "18.6.1",
    "@commitlint/config-conventional": "16.2.4",
    "@eslint/js": "9.39.5",
    "@microsoft/api-extractor": "7.60.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-check-file": "3.3.2",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-prettier": "5.5.7",
    "globals": "17.14.0",
    "happy-dom": "21.0.4",
    "husky": "7.0.4",
    "jiti": "2.7.0",
    "lint-staged": "12.3.2",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.73.0",
    "vite": "7.3.8",
    "vite-plugin-dts": "5.1.2",
    "vitest": "4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "ajv-draft-04": {
      "ajv": "8.20.0"
    }
  }
}
