{
  "name": "mxs",
  "version": "0.11.0",
  "description": "⚔️ Lightweight functional JavaScript utilities",
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=24"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "npm run lint --fix",
    "format": "prettier --write 'src/**/*.{js,md,json}'",
    "build": "vite build && tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build",
    "docs:serve": "docsify serve ./docs -P 3000",
    "generate-fn-md": "jsdoc2md",
    "validate": "npm run lint && npm test",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "src/**/*.{js,json,md}": [
      "prettier --write ."
    ],
    "src/**/*": [
      "npm lint --fix",
      "npm test --findRelatedTests --bail"
    ]
  },
  "repository": "git@github.com:helderburato/maximus.git",
  "author": "Helder Burato Berto <helder.burato@gmail.com> (https://helderburato.com)",
  "keywords": [
    "maximus",
    "mx",
    "functional",
    "utils",
    "utilities",
    "lightweight",
    "fp"
  ],
  "files": [
    "dist/",
    "LICENSE",
    "README.md"
  ],
  "devDependencies": {
    "@commitlint/cli": "^18.4.4",
    "@commitlint/config-conventional": "^16.0.0",
    "@types/node": "^24.19.2",
    "docsify-cli": "^4.4.2",
    "eslint": "^8.7.0",
    "eslint-config-prettier": "^8.1.0",
    "eslint-config-standard": "^16.0.2",
    "eslint-plugin-import": "^2.25.4",
    "eslint-plugin-node": "^11.1.0",
    "eslint-plugin-prettier": "^4.0.0",
    "eslint-plugin-promise": "^6.0.0",
    "eslint-plugin-standard": "^5.0.0",
    "husky": "^7.0.4",
    "jsdoc-to-markdown": "^7.1.0",
    "lint-staged": "12.3.2",
    "prettier": "^2.5.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^4.1.12"
  },
  "license": "MIT"
}
